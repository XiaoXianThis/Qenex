{
  "name": "qenex",
  "private": true,
  "workspaces": ["apps/*", "packages/*", "scratch/*"],
  "scripts": {
    "dev:bridge": "bun run --filter @qenex/bridge start",
    "dev:web": "bun run --filter @qenex/web dev",
    "test:bridge": "bun run --filter @qenex/bridge test",
    "test:web": "bun run --filter @qenex/web test",
    "test:phase0": "bun run --cwd scratch/phase0 test",
    "test:phase2": "bun run --cwd packages/core test && bun run --cwd packages/ui test && bun run --cwd apps/web test && bun run --cwd apps/web test:e2e"
  }
}
